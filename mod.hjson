#the mod name as displayed in-game
displayName: "组合单位"

#the internal name of your mod
name: "combineunit"

#your name
author: "R"

#the fully qualified main class of the mod
main: "combineunit.Main"

#the mod description as seen in the mod dialog
description: "组合工厂QQ群:973942058\n组合单位（从组合工厂 combine 里拆出来单独维护）：\n· 单位合体：框选同队单位一键合体成「组合巨兽」，血量/护甲/护盾/武器/能力按成员叠加保留，点选巨兽可随时解体\n· 组合巨兽按成员构成决定飞行/游泳/行走，贴图取数量最多的成员类型并按体型缩放；会飞的编组带引擎、挖矿编组带挖矿光束、工程编组按成员数叠加建造速度\n· 组合单位共享承伤：同组单位按当前生命占比分摊伤害，修复也按整组摊\n· 组合火力共享：开火单位可调用同组空闲单位的就绪武器代打（治疗类武器不代打）\n· 指挥模式里可给单位编组/并组/退组（框选后点顶部「组合」按钮）\n· 组合单位的环境适应按成员推导（埃里克尔地图上合体不会因为灼热环境当场死亡）"

#the mod version
version: 1.0

#the minimum game build required to run this mod
minGameVersion: 160.1

#this is a java mod
java: true
